rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /analyses/{analysisId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.status == 'Completed'
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() > 0
          && request.resource.data.fileName.size() <= 180
          && !request.resource.data.keys().hasAny([
            'filename',
            'path',
            'rawText',
            'bytes',
            'uri'
          ]);
        allow update, delete: if false;
      }

      // Both clients use settings/preferences and may also read legacy
      // usage, datasets, and reports records owned by the same account.
      match /settings/{settingId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /usage/{recordId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /datasets/{recordId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /reports/{recordId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.status == 'Completed'
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() > 0
          && request.resource.data.fileName.size() <= 180
          && !request.resource.data.keys().hasAny([
            'filename',
            'path',
            'rawText',
            'bytes',
            'uri'
          ]);
        allow update: if isOwner(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == userId;
        allow delete: if false;
      }
    }
  }
}
